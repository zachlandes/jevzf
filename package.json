{
  "name": "jevzf",
  "version": "0.1.0",
  "description": "Meaning-ranked piped text for stock fzf, powered by TypeSafe Jev",
  "type": "module",
  "bin": {
    "jevzf": "bin/jevzf.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test",
    "lint": "node --check bin/jevzf.mjs && find lib test scripts packages/decision-gate/lib packages/decision-gate/test -name '*.mjs' -exec node --check {} \\;"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachlandes/jevzf.git"
  },
  "bugs": {
    "url": "https://github.com/zachlandes/jevzf/issues"
  },
  "homepage": "https://github.com/zachlandes/jevzf#readme",
  "keywords": [
    "fzf",
    "semantic-search",
    "jev",
    "cli"
  ],
  "dependencies": {
    "decision-gate": "^0.1.0"
  }
}
